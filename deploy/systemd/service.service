# Example unit for the stand (FIN-149): Go services under systemd, one PostgreSQL.
# Install as /etc/systemd/system/<service>.service, replace "service" with the name.
# The deploy script runs "<binary> migrate up" (same environment) before restarting the unit.
#
# Secrets are systemd credentials, not environment variables: they do not show up in
# "systemctl show" or /proc/<pid>/environ.
#   /etc/finassist/<service>/env            non-secret settings (see docs/config.md)
#   /etc/finassist/<service>/db-primary-dsn DSN, mode 0600, owner root
[Unit]
Description=fin-assist service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/opt/finassist/service/service serve
EnvironmentFile=/etc/finassist/service/env
Environment=ENV=stage
LoadCredential=db-primary-dsn:/etc/finassist/service/db-primary-dsn
Environment=DB_PRIMARY_DSN_FILE=%d/db-primary-dsn
# AUTH_MODE=verify on the stand uses stage file keys (FIN-323). The env file sets
# AUTH_USER_ISSUER, AUTH_USER_AUDIENCE, PEER_USER_ADDR and AUTH_STAGE_ISSUER.
LoadCredential=stage-signing-key:/etc/finassist/service/stage-signing-key.pem
Environment=AUTH_STAGE_SIGNING_KEY_FILE=%d/stage-signing-key
Environment=AUTH_STAGE_PUBLIC_KEYS_FILE=/etc/finassist/stage-keys.json

DynamicUser=yes
Restart=on-failure
RestartSec=2s
# SHUTDOWN_DELAY + SHUTDOWN_TIMEOUT (5s + 20s by default) plus a margin.
TimeoutStopSec=30s
KillSignal=SIGTERM

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
